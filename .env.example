# Copy to .env and fill in ANTHROPIC_AUTH_TOKEN. .env is gitignored, never commit it.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://iu-digitalisierung-seminar.services.ai.azure.com/anthropic
ANTHROPIC_MODEL=claude-haiku-4-5

# Postgres connection used by the pipeline inside the container.
DATABASE_URL=postgresql://ingest:ingest@db:5432/ingest
